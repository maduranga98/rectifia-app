rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Role + company identity come from Firebase Auth custom claims, set
    // once (functions/src/staff/inviteStaff.js) when a Company Admin invites
    // someone and never writable by the client. Every role check below reads
    // request.auth.token, never a Firestore doc, so a compromised staff doc
    // can't be used to escalate privilege.
    function hasRole(companyId, role) {
      return request.auth != null
        && request.auth.token.companyId == companyId
        && request.auth.token.role == role;
    }
    function isCompanyStaff(companyId) {
      return request.auth != null && request.auth.token.companyId == companyId;
    }
    function isCompanyAdmin(companyId) { return hasRole(companyId, 'companyAdmin'); }
    function isHrCoordinator(companyId) { return hasRole(companyId, 'hrCoordinator'); }
    function isPulseReviewer(companyId) { return hasRole(companyId, 'pulseCheckReviewer'); }
    function isManager(companyId) { return hasRole(companyId, 'manager'); }
    function isCaseHandler(companyId) { return hasRole(companyId, 'caseHandler'); }

    // The composable custom-role layer (companies/{companyId}/customRoles).
    // A staff account holds `request.auth.token.role` (one of the fixed
    // roles above) XOR `request.auth.token.customRoleId` - never both, never
    // neither, the same invariant functions/src/utils/permissionResolver.js
    // enforces server-side on every write. hasCustomPermission reads the
    // custom role's `permissions` array fresh from Firestore on every check
    // rather than trusting anything cached in the token, so editing a custom
    // role's permissions (RoleBuilder.jsx) takes effect for every staff
    // member holding it immediately - no reissued token needed.
    //
    // This is the mirror-in-rules half of permissionResolver.js's logic that
    // module 2's design note at the top of this file already calls for: rules
    // can't literally import that CommonJS module, so the same
    // PERMISSION_MODULE_KEYS allowlist and the same "exactly one of role /
    // customRoleId" shape must be kept here by hand. caseHandler and
    // hrCoordinator are never expressed as a permission key in either copy of
    // the allowlist - hasCustomPermission has no key it could ever be called
    // with that would grant either.
    function hasCustomPermission(companyId, key) {
      return request.auth != null
        && request.auth.token.companyId == companyId
        && request.auth.token.customRoleId != null
        && key in get(/databases/$(database)/documents/companies/$(companyId)/customRoles/$(request.auth.token.customRoleId)).data.permissions;
    }

    // "A Company Admin of some company" - deliberately not scoped to one
    // company. Used for the legacy list-based slug-uniqueness probe on the
    // companies match block below (see the comment there), and for reading
    // companySlugs/{slug} registry docs during reserveUniqueSlug's
    // transaction (companyId-scoped writes to that collection are further
    // restricted by isCompanyAdmin(companyId) - see the companySlugs match
    // block).
    function isAnyCompanyAdmin() {
      return request.auth != null && request.auth.token.role == 'companyAdmin';
    }

    // The public reporting slug is the one field on a company doc that an
    // anonymous reporter's link resolves against, so once it exists it must
    // never move: a reassigned slug silently breaks every printed QR code and
    // could point reporters at a different company. A Company Admin may write
    // it exactly once, while it is still absent (the self-service "Generate
    // reporting link" action on the overview page); after that only a Super
    // Admin can touch it.
    // The only company-doc fields a Company Admin may write directly, edited
    // in place from the Company Admin panel: pulse-check cadence (Settings
    // page), jurisdictions (Settings page) and departments (Departments page).
    // hasOnly() is an allowlist, not a blocklist - a write that touches any
    // other field (subscriptionTier, billingStatus, name, slug, case-count
    // rollups, ...) fails outright, so this is deliberately NOT a blanket
    // "can write their own company doc" grant. Slug is handled by its own
    // one-time path (claimsMissingSlug) below and is not in this set.
    // followUpConfig is the per-company retaliation follow-up cadence
    // (intervalsDays + disabledCategories), edited on the Settings page and
    // read server-side by functions/src/followup/scheduleFollowUps.js. Like the
    // others it is company structure/config, not case content, so a Company
    // Admin may write it directly - but only through this allowlist, so a write
    // touching any other field still fails outright.
    // employeeCount is the self-declared headcount BillingQuote.jsx reads to
    // show a company's REFERENCE quote and matching plan/add-on tier - and,
    // per functions/src/billing/pricingEngine.js's readDeclaredEmployeeCount(),
    // the number requestQuote.js's "Contact sales" request is filed at, not
    // the live employees roster. Pilot v1 has no self-serve subscription
    // path at all, so a Company Admin declaring this number never buys or
    // changes anything by itself - it only decides what reference number
    // they see and what headcount a quote request names. subscriptionTier,
    // pulseCheckEnabled, pulseCheckTier, billingStatus, and the *UpdatedAt
    // companions stay OUT of this allowlist on purpose - those are only ever
    // written by a human directly (Admin SDK / Stripe Dashboard, after
    // negotiating a real price) or reconciled by stripeWebhook.js, never
    // directly by the client.
    // crisisContact is the { name, email, phone } record
    // functions/src/intake/routeCase.js notifies when a report is crisis-
    // flagged (Settings page). It is a contact record, not a staff account or
    // claim - deliberately not bound to a uid, since the recipient may be an
    // external EAP provider or counsellor with no login - so writing it grants
    // no case-content access and stays inside this same field allowlist rather
    // than widening the company doc to a blanket admin-writable document.
    // timeZone is an IANA identifier string (Settings page) that
    // functions/src/utils/companySchedule.js reads to pick the local hour
    // for the checkOverdueDeadlines and schedulePulseChecks sweeps - company
    // config, not case content, validated client-side by
    // src/services/companyService.js's isValidTimeZone() before this write
    // is even attempted, same "client validates, this allowlist is the real
    // gate" pattern as every other field here.
    function companyAdminEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['pulseCheckCadence', 'jurisdictions', 'departments', 'followUpConfig', 'crisisContact', 'retention', 'timeZone', 'employeeCount']);
    }

    // A custom-role holder's write to the company doc is scoped BOTH by which
    // permission they hold AND to only the one field that permission covers -
    // narrower than companyAdminEditableFields() above, which is a single
    // allowlist Company Admin's unconditional access shares across every
    // field in it. 'departments' maps to the departments permission key,
    // 'jurisdictions' to complianceConfig, and 'retention' to
    // retentionSettings (still additionally checked by
    // isValidRetentionUpdate()/retentionFieldValid() below - a
    // retentionSettings permission does not relax those floors). No custom
    // permission maps to pulseCheckCadence, followUpConfig, or
    // crisisContact - those stay Company Admin only, same as before this
    // module.
    function isCustomRoleCompanyFieldEditor(companyId) {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return (hasCustomPermission(companyId, 'departments') && diff.hasOnly(['departments']))
        || (hasCustomPermission(companyId, 'complianceConfig') && diff.hasOnly(['jurisdictions']))
        || (hasCustomPermission(companyId, 'retentionSettings') && diff.hasOnly(['retention']));
    }

    // Module 23's four configurable retention windows (companies/{companyId}.
    // retention), validated here rather than trusted from the client, and
    // enforced on EVERY writer of this field - including Super Admin, via the
    // retentionFieldValid() gate below applying to both branches of the
    // update rule. The floors mirror functions/src/retention/retentionPolicy.js
    // exactly and exist for the same reason documented there: employment-claim
    // limitation periods run for years after the events a case describes, so
    // nothing that writes through this rule - not a Company Admin, not a
    // Super Admin acting through this same field - can configure a window
    // shorter than the floor. Going lower than a floor requires a lawyer and a
    // code change to the floor itself, not a client write.
    // referenceCaseRetention deliberately has no field here at all - it is not
    // part of this shape because it is not configurable by anyone; see
    // REFERENCE_CASE_RETENTION in retentionPolicy.js.
    // updatedByUid/updatedAt must match the write's own auth uid and server
    // time, so a retention change always carries who made it and when -
    // shortening a retention window is a consequential act.
    function isValidRetentionUpdate() {
      let r = request.resource.data.retention;
      return r.identityRetentionDays is int && r.identityRetentionDays >= 90 && r.identityRetentionDays <= 1825
        && r.caseRetentionDays is int && r.caseRetentionDays >= 1095 && r.caseRetentionDays <= 3650
        && r.pulseResponseRetentionDays is int && r.pulseResponseRetentionDays >= 180 && r.pulseResponseRetentionDays <= 1825
        && r.auditLogRetentionDays is int && r.auditLogRetentionDays >= 2555
        && r.updatedByUid == request.auth.uid
        && r.updatedAt == request.time;
    }
    function retentionFieldValid() {
      return !('retention' in request.resource.data.diff(resource.data).affectedKeys())
        || isValidRetentionUpdate();
    }

    // Per-company feature flags (companies/{companyId}.featureFlags), the
    // registry src/config/featureFlags.js and functions/src/utils/
    // featureFlags.js both resolve against. A flat map, only the known keys,
    // only boolean values - keys().hasOnly()/values().hasOnly() reject
    // anything else outright rather than letting a malformed value sit in
    // the document for a reader to misinterpret as "on".
    function isValidFeatureFlagsMap() {
      let flags = request.resource.data.featureFlags;
      return flags is map
        && flags.keys().hasOnly(['pulseCheck', 'benchmarkPool', 'aiFollowUp',
            'externalShareLinks', 'patternDetection', 'burnoutTrendDetection', 'policyGrounding'])
        && flags.values().hasOnly([true, false]);
    }
    // Super Admin only, full stop - this is the enforcement layer behind
    // FeatureFlagPanel.jsx, not the panel's own role check. Written as its
    // own gate (mirroring retentionFieldValid() above) rather than folded
    // into companyAdminEditableFields()/isCustomRoleCompanyFieldEditor(), so
    // that widening either of those allowlists in the future can never
    // accidentally hand Company Admin or a custom role write access to this
    // field too - featureFlags stays off both by construction.
    function featureFlagsFieldValid() {
      return !('featureFlags' in request.resource.data.diff(resource.data).affectedKeys())
        || (isSuperAdmin() && isValidFeatureFlagsMap());
    }

    // companies/{companyId}.suspended (+ suspendedAt/suspendedReason) - the
    // Super Admin suspend/reactivate action (companyService.js's
    // setCompanySuspended). Deliberately not in companyAdminEditableFields,
    // same reasoning as featureFlagsFieldValid above: a company can never
    // suspend itself, and widening that allowlist later can't accidentally
    // hand it write access to this field too. suspended must be a bool when
    // touched; suspendedAt/suspendedReason ride along unchecked since they're
    // display-only and only ever set by the same trusted call site.
    function suspensionFieldValid() {
      return !('suspended' in request.resource.data.diff(resource.data).affectedKeys())
        || (isSuperAdmin() && request.resource.data.suspended is bool);
    }
    // Billing-critical fields, written only by the Admin SDK - stripeWebhook.js
    // reacting to Stripe, and functions/src/billing/linkCompanySubscription.js
    // when a Super Admin links or re-links a subscription. Mirrors
    // companyAdminEditableFields()'s allowlist pattern, but as a blocklist:
    // Super Admin otherwise has a blanket write to the rest of the company
    // doc, and this is what carves these six fields out of that grant so
    // there is no client path to them at all - not CompanySetup.jsx, not a
    // Super Admin session in the Firestore console, nothing. Applied to every
    // UPDATE of this document regardless of who the writer is.
    //
    // billingStatus/subscriptionTier are deliberately absent from this list's
    // CREATE-time counterpart below (isValidCompanyCreate) - a brand new
    // company must be able to start out billingStatus:'unbilled' with no
    // subscriptionTier at all, written by createCompany() itself. It is only
    // updates - every write after that first one - that these six fields are
    // sealed against.
    function superAdminBillingFieldsLocked() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['stripeSubscriptionId', 'stripeCustomerId', 'billingStatus', 'subscriptionTier',
          'stripeCoreItemId', 'stripePulseCheckItemId', 'currentEmployeeCount',
          // 7-day trial tracking (scheduleTrialExpiration.js/checkTrialExpirations.js)
          // and its growth-action block. No client write - not even a Super
          // Admin's own browser - can ever touch these; only the Admin SDK
          // (the trigger, the daily sweep, and applySubscriptionState.js
          // clearing the block once a subscription exists) may write them.
          'accessBlocked', 'accessBlockedAt', 'trialStartedAt', 'trialEndsAt', 'trialWarningNotifiedAt']);
    }

    // featureFlags.pulseCheck specifically - not the rest of the featureFlags
    // map, which stays Super-Admin-writable via FeatureFlagPanel.jsx/
    // featureFlagsFieldValid() above - is one of the six fields
    // superAdminBillingFieldsLocked() protects. Rules' affectedKeys() only
    // ever reports the top-level 'featureFlags' key even for a dotted-path
    // update, so the lock has to compare the value directly: a write that
    // touches featureFlags at all is only valid if pulseCheck's value (or
    // absence) is unchanged by it. applySubscriptionState() is the only
    // place that ever flips this flag, via the Admin SDK, which bypasses
    // these rules entirely.
    function pulseCheckFeatureFlagLocked() {
      return !('featureFlags' in request.resource.data.diff(resource.data).affectedKeys())
        || request.resource.data.featureFlags.get('pulseCheck', null)
          == resource.data.get('featureFlags', {}).get('pulseCheck', null);
    }

    // The one allowed shape for a brand new company doc's billing fields:
    // billingStatus must be exactly 'unbilled' (a genuinely un-billed
    // company, distinct from 'unknown' and from every PAYING_BILLING_STATUSES
    // value - see companyService.js's createCompany), and none of the other
    // five billing-critical fields may be present at all - no subscription
    // has been linked yet, so there is nothing for them to hold.
    function isValidCompanyCreate() {
      return request.resource.data.billingStatus == 'unbilled'
        && !('subscriptionTier' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data)
        && !('stripeCustomerId' in request.resource.data)
        && !('stripeCoreItemId' in request.resource.data)
        && !('stripePulseCheckItemId' in request.resource.data);
    }
    function claimsMissingSlug() {
      return (!('slug' in resource.data) || resource.data.slug == null)
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 100
        // Same shape slugifyCompanyName produces: lowercase alphanumeric
        // groups joined by single hyphens, no leading/trailing hyphen.
        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    // Platform Super Admin: allowlist membership at superAdmins/{uid}, the
    // same check AuthContext/SuperAdminLoginPage make client-side. get()/
    // exists() here bypass the read rule on that collection, so this works
    // even though a user may only read their own allowlist doc.
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    // Company onboarding is a Super Admin action (SuperAdminDashboardPage ->
    // CompanySetup), so this is no longer the world-writable placeholder it
    // was when a company had to be created before any account existed:
    // anyone could previously create, rewrite, or delete any company doc.
    // A Company Admin keeps write access to their own company, but only to an
    // explicit field allowlist (pulseCheckCadence, jurisdictions, departments -
    // see companyAdminEditableFields above), never a blanket company-doc write.
    //
    // Reading someone else's company doc stays off-limits: `get` is still the
    // requester's own company (or any, for a Super Admin). `list` is opened up
    // one document at a time, and only for a Company Admin - a leftover allowance
    // from when slug-taken checks queried this collection directly; slug
    // allocation now goes through the companySlugs registry below instead
    // (reserveUniqueSlug), but this is kept as a narrow, harmless allowance
    // rather than removed as an unrelated cleanup. A collection-wide dump of
    // the company list has no such limit, so it is still denied. Slug writes
    // are narrower still: they fall outside the
    // companyAdminEditableFields allowlist, so the only Company Admin path that
    // can touch slug is claimsMissingSlug() above - any other role has no update
    // path here at all, so a company's reporting slug is only ever writable by
    // its own Company Admin (once) or a Super Admin.
    match /companies/{companyId} {
      allow get: if isSuperAdmin() || isCompanyStaff(companyId);
      allow list: if isSuperAdmin()
        || (isAnyCompanyAdmin() && request.query.limit <= 1);
      allow create: if isSuperAdmin() && isValidCompanyCreate();
      allow update: if (isSuperAdmin()
          || (isCompanyAdmin(companyId) && (companyAdminEditableFields() || claimsMissingSlug()))
          || isCustomRoleCompanyFieldEditor(companyId))
        && retentionFieldValid()
        && featureFlagsFieldValid()
        && superAdminBillingFieldsLocked()
        && pulseCheckFeatureFlagLocked()
        && suspensionFieldValid();
      allow delete: if isSuperAdmin();
    }

    // Registry of claimed reporting slugs, doc id == the slug itself
    // (companyService.js's reserveUniqueSlug). Its only purpose is making
    // slug allocation atomic: a Super Admin (createCompany) or a Company
    // Admin claiming their own missing slug (assignCompanySlug) runs a
    // transaction that reads candidate slug docs here and creates the first
    // one that doesn't exist, in the same transaction as the companies/{id}
    // write - so two callers racing on the same company name can never both
    // land on the same slug the way a plain "query, then write" check could.
    // Never updated or deleted: once claimed, a slug is claimed for good
    // (companies/{companyId} itself is still the only place a slug is ever
    // read back from for routing).
    match /companySlugs/{slug} {
      allow get: if isSuperAdmin() || isAnyCompanyAdmin();
      allow create: if isSuperAdmin()
        || (isAnyCompanyAdmin() && isCompanyAdmin(request.resource.data.companyId));
      allow update, delete: if false;
    }

    // Audit trail for a company's plan/add-on tier and its billing-relevant
    // manual changes - who, when, and the from/to tier. Written only by
    // trusted Admin SDK code, never by a client, so a client write can never
    // fabricate or erase an entry. Read-only for the company's own Company
    // Admin (this is their record of their own plan-change history) and
    // Super Admin.
    match /companies/{companyId}/billingHistory/{entryId} {
      allow read: if isSuperAdmin() || isCompanyAdmin(companyId);
      allow write: if false;
    }

    // Internal record of a "Request a quote" request
    // (functions/src/billing/requestQuote.js), including the computed
    // reference quote for Lumora's own sales follow-up. Never
    // client-readable - even the requesting Company Admin does not read this
    // back; the callable's own return value is a bare confirmation with no
    // pricing figures, precisely so the formula and per-employee rates
    // behind a quote are never exposed to a client. Written only by that
    // callable's Admin SDK.
    match /quoteRequests/{companyId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Platform-level Super Admin allowlist, doc id == the account's Firebase
    // Auth uid. SuperAdminLoginPage/AuthContext check "does a doc exist at
    // superAdmins/{my uid}" to decide super-admin access - not a custom
    // claim. Entries are added only via functions/scripts/addSuperAdmin.js
    // (Admin SDK, run by hand), never by a client write; a signed-in user
    // may only read their own doc, just enough to check their own status.
    match /superAdmins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Case documents are gated by a passcode, not by auth, so client SDK
    // access is never allowed - not even by a correct Case ID. Reads and
    // writes only ever happen through the Cloud Functions in
    // functions/src/intake/generateCaseAccess.js, which run with the Admin
    // SDK and bypass these rules entirely. That includes the investigation
    // checklist (module 9's `checklist` field, written by
    // generateChecklist.js / updateChecklistItem.js) and the consistency
    // flag (module 10's `consistencyCheck` field, written by
    // checkConsistency.js) - both live on this same locked-down document,
    // read and written only through their respective callables.
    // A case document now also carries the tier/provenance fields written by
    // submitCase.js and createCaseOnBehalf.js - tier, source, intakeMethod,
    // reportedAt, and for staff-filed cases enteredByUid/enteredByRole - plus,
    // for confidential-tier cases only, a `reporterIdentity` map.
    //
    // reporterIdentity holds an AES-GCM envelope from
    // functions/src/utils/identityVault.js, never plaintext, and that is load-
    // bearing here rather than belt-and-braces: the read rule below hands the
    // assigned handler the *whole* document and Firestore rules cannot filter
    // fields, so the only thing that keeps a reporter's name out of that read
    // is that the field does not contain one. Decryption is not reachable from
    // any client rule at all - it goes through decryptIdentity(), which needs a
    // Super Admin session and a documented reason and audits every attempt.
    // For anonymous-tier cases the field is absent entirely, so there is
    // nothing to read even in ciphertext.
    //
    // Module 20 adds two more reporter-controlled facts to this document and
    // changes nothing about the rules below, deliberately:
    //
    //   - `reporterIdentity` can now appear on a case that was filed
    //     anonymously, because a reporter may choose to identify themselves
    //     mid-case (functions/src/intake/identityTransition.js). Its shape and
    //     its protection are identical either way: an envelope, unreadable
    //     without the Secret Manager key, and unreachable from any client rule.
    //     "Anonymous cases have no identity field" is no longer a thing any
    //     reader may assume; "no client can read the identity" still is.
    //
    //   - `contactEmail` is a second envelope, holding the address a reporter
    //     optionally supplied so we can mail them a content-free "there is an
    //     update" notice. It is subject to the exact same rule: unreadable by
    //     every client role, caseHandler included. The handler read below hands
    //     over the whole document, so - as with reporterIdentity - what keeps
    //     the address out of that read is that the field does not contain one.
    //
    // Neither field may ever be moved to a client-readable collection, and
    // neither may be decrypted by anything but the audited server paths:
    // revealIdentity.js for the identity, sendContactEmailUpdate.js for the
    // address. Every decrypt of either writes an identityAccessAuditLog entry
    // whether it succeeds or fails, and that collection is denied to every
    // client below - a mutable audit trail is not an audit trail.
    //
    // Module 23 adds three more fields, all Admin-SDK-write-only like every
    // other field on this document: `legalHold` (functions/src/retention/
    // legalHold.js), `deletionRequested` (functions/src/retention/
    // deletionRequest.js) and `identityPurgedAt` (functions/src/retention/
    // applyRetention.js's Tier 1 sweep). None of them are case content - a
    // hold reason, a pending-erasure flag and a purge timestamp say nothing
    // about what was reported - so the assigned handler seeing them in the
    // same whole-document read below is not new exposure, and none is
    // mirrored to caseMetadata for the same reason `responses` is not.
    match /cases/{caseId} {
      // Writes still only ever happen through Cloud Functions with the
      // Admin SDK (generateCaseAccess.js, scoreCase.js, routeCase.js,
      // caseActions.js, etc). Reads are opened up in exactly one case: the
      // Case Handler dashboard (module 12) needs to list and view only the
      // cases assigned to the logged-in handler, enforced here rather than
      // just in the UI. This assumes a Case Handler's Firebase Auth uid
      // equals their staff doc id / assignedHandlerId - the same
      // no-full-staff-auth placeholder other modules already lean on until
      // real Case Handler accounts exist.
      allow read: if request.auth != null && request.auth.uid == resource.data.assignedHandlerId;
      allow write: if false;

      // The message thread (module 8) stays fully locked down even for the
      // assigned handler - access is through getCaseThread /
      // postInvestigatorMessage (functions/src/intake/caseThread.js), not
      // direct reads, so the poll-based client in CaseThread.jsx keeps
      // working unchanged.
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // Company policy documents (module 19). A Company Admin uploads and manages
    // their organisation's own written policies; any staff of the company may
    // read the document metadata (title, status, version, chunk count, category
    // coverage) so the investigation roles can see what grounding exists and
    // open the source via a signed URL. Following the same per-company scoping
    // pattern as routingRules/employees above: read by any staff of that
    // company, write by that company's Company Admin only. The parent-doc write
    // grant covers status flips (archive/restore) issued via the manage
    // callables, but every uploaded file's bytes stay signed-URL only, and the
    // chunks below are Admin-SDK only. This grants Company Admin no case-content
    // access: a policy document is company structure, never a case.
    match /companyPolicies/{policyId} {
      allow read: if isCompanyStaff(resource.data.companyId);
      allow create: if isCompanyAdmin(request.resource.data.companyId)
        || hasCustomPermission(request.resource.data.companyId, 'policyManagement');
      allow update, delete: if isCompanyAdmin(resource.data.companyId)
        || hasCustomPermission(resource.data.companyId, 'policyManagement');

      // Chunks are extracted, tagged, and read entirely server-side
      // (ingestPolicyDocument.js, tagPolicyChunks.js, retrievePolicyContext.js
      // with the Admin SDK). Any staff of the owning company may read them if
      // they hold a path to the parent, but no client ever writes one - the
      // chunking is not a client-authored surface.
      match /chunks/{chunkId} {
        allow read: if isCompanyStaff(get(/databases/$(database)/documents/companyPolicies/$(policyId)).data.companyId);
        allow write: if false;
      }
    }

    // Case routing configuration (module 7). Company Admin accounts now
    // exist (see functions/src/staff/inviteStaff.js), so this is gated by
    // custom claims instead of the earlier no-auth placeholder. Any staff
    // member of the company can read the rules (Case Handlers need to know
    // who they route to); only a Company Admin edits them.
    match /companies/{companyId}/routingRules/{ruleId} {
      allow read: if isCompanyStaff(companyId);
      allow write: if isCompanyAdmin(companyId) || hasCustomPermission(companyId, 'routingRules');
    }

    // The composable custom-role definitions themselves. Readable by any
    // staff of the company (a custom-role holder needs to know their own
    // role's name; RoleBuilder.jsx needs to list them for Company Admin to
    // edit). All writes - create, update, delete - go exclusively through
    // functions/src/roles/customRoles.js with the Admin SDK, never a direct
    // client write, for two reasons no rules predicate could enforce on its
    // own: `permissions` must be validated against the
    // PERMISSION_MODULE_KEYS allowlist (hasCustomPermission's own allowlist
    // duplication problem, but for the writer instead of the reader), and a
    // delete must first check no staff member's customRoleId still points at
    // this doc - a query rules cannot express against an arbitrary,
    // unenumerated set of staff ids.
    match /companies/{companyId}/customRoles/{roleId} {
      allow read: if isCompanyStaff(companyId);
      allow write: if false;
    }
    // The JP designated-handler (従事者) register. Metadata only - who is
    // designated, by whom, when, and whether they've acknowledged the
    // confidentiality obligation; never case content, case IDs, or case
    // counts. Readable by any staff of the company: a designated handler
    // needs to see their own status to acknowledge it, and
    // DesignatedHandlersPage.jsx needs to list the register for Company
    // Admin / a designatedHandlers-permitted role to manage. All writes -
    // designate, revoke, acknowledge - go exclusively through
    // functions/src/compliance/designatedHandlers.js with the Admin SDK,
    // same pattern as customRoles above: a designation must be tied to a
    // logged actor (designatedByUid/revokedByUid) and an acknowledgment must
    // be provably the handler's own act, neither of which a rules predicate
    // alone can guarantee against a direct client write.
    match /companies/{companyId}/designatedHandlers/{staffUid} {
      allow read: if isCompanyStaff(companyId);
      allow write: if false;
    }
    // Staff docs are created only by inviteStaff.js (Admin SDK), never by a
    // direct client write - that's the boundary that stops someone minting
    // their own companyAdmin/hrCoordinator staff record. A Company Admin can
    // still edit an existing staff doc directly (e.g. deactivating someone).
    // Super Admin reads staff too, for exactly one reason: the manual-
    // assignment queue (SuperAdminDashboardPage) has to offer that company's
    // Case Handlers to pick from when resolving a case routeCase.js could not
    // route. A staff doc is account metadata (email, role, department, job
    // title) - it is not case content, so this does not widen the
    // no-case-content-access rule.
    match /companies/{companyId}/staff/{staffId} {
      allow read: if isCompanyStaff(companyId) || isSuperAdmin();
      allow create: if false;
      // Neither a Company Admin nor a staffManagement custom-role holder may
      // touch `role`, `customRoleId`, or `departments` through this direct
      // write path - those are the fields that carry authorization, and they
      // may only change alongside the matching Auth custom claim, which only
      // functions/src/roles/assignStaffRole.js and inviteStaff.js (Admin SDK)
      // can set. A direct client write to either field would desync this
      // doc's mirror from the actual claim the rest of the app trusts; the
      // hasOnly() below closes that path for every writer, not only a
      // staffManagement holder.
      allow update: if (isCompanyAdmin(companyId) || hasCustomPermission(companyId, 'staffManagement'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'department', 'jobTitle']);
      allow delete: if isCompanyAdmin(companyId);
    }

    // Pulse Check recipient roster (module 14) - deliberately a different
    // collection from companies/{companyId}/staff above, not an extra field on
    // it. A staff doc is a login-having account: its id is a Firebase Auth
    // uid, it carries a role, and it can only be created server-side by
    // inviteStaff.js precisely so nobody can mint their own privileged record.
    // An employee doc is the opposite - no account, no uid, no role, nothing
    // that grants access to anything - so a Company Admin can create these
    // directly (including a several-hundred-row CSV import from
    // src/services/employeeService.js) without that being a privilege-
    // escalation path: the worst a bad write here can do is queue a pulse
    // check for someone who doesn't exist.
    //
    // Read is open to any staff of the company (HR Coordinator and Pulse Check
    // Reviewer need to resolve an employeeId on a pulse response to a person);
    // updates (editing name/department/email on an existing entry) are
    // Company Admin only, the same as departments and routing rules. `email`
    // is optional by design - see schedulePulseChecks.js, which queues an
    // invite either way.
    //
    // create/delete are deliberately absent - a company's roster size is now
    // cap/billing-relevant (companies/{companyId}.currentEmployeeCount, the
    // counter addEmployee.js/removeEmployee.js/bulkAddEmployees.js enforce
    // the plan's headcount cap against), so those writes must happen
    // transactionally alongside that counter, atomically, which only the
    // Admin SDK can guarantee. addEmployee.js, removeEmployee.js, and
    // bulkAddEmployees.js are the only remaining way to create or delete a
    // roster entry - matching the same "no client-side write path for
    // anything cap/billing-relevant" principle already applied to
    // stripeSubscriptionId and friends above (superAdminBillingFieldsLocked).
    match /companies/{companyId}/employees/{employeeId} {
      allow read: if isCompanyStaff(companyId);
      allow update: if isCompanyAdmin(companyId);
    }

    // Published pulse-check questionnaires (module 21), one immutable document
    // per version. A version records the exact question list - core plus the
    // company's supplementary questions - that was live when it was published,
    // and every pulse response stores the version it answered.
    //
    // Read is open to any staff of the company: this is the questions, not the
    // answers, and the HR-side reader, the admin editor, the preview and the
    // trend markers all need it. Nothing here is identifying.
    //
    // Write is Admin SDK only - not "Company Admin only", not even
    // "create-only". Publishing goes exclusively through publishQuestionSet in
    // functions/src/pulse/questionSet.js, which allocates the next version
    // number under a transaction and create()s the document. If a published
    // version were client-writable, an admin could rewrite the wording of a
    // version months of stored responses point at, and every one of those
    // responses would silently start resolving to a question that was never
    // asked - which is the exact failure the versioning exists to prevent.
    // Removing a supplementary question changes the NEXT version, never a past
    // one, so there is no legitimate client write path here at all.
    match /companies/{companyId}/questionSets/{version} {
      allow read: if isCompanyStaff(companyId);
      allow write: if false;
    }

    // Case-count rollup for the Company Admin overview page (module 15),
    // maintained by functions/src/company/syncCompanyStats.js from
    // caseMetadata - counts and breakdowns only (byStatus/byPriority/
    // byCategory/byHandler, overdue/approaching-deadline counts), never a
    // case id, category-of-one, or anything else that could re-identify a
    // case. byHandler keys on assignedHandlerId, a staff id Company Admin can
    // already read via companies/{companyId}/staff below - not new exposure.
    // This is the only case-derived collection Company Admin can read; it
    // still has no rules path to cases/, messages/, or caseMetadata/ itself.
    match /companies/{companyId}/stats/{statId} {
      allow read: if isCompanyAdmin(companyId);
      allow write: if false;
    }

    // Module 28's analytics & reporting dashboard: trend documents
    // (trend_YYYY-MM) and one consistency summary document, recomputed daily
    // by functions/src/analytics/aggregateCaseAnalytics.js from caseMetadata
    // and referenceCases only - it never reads cases/{caseId} or any
    // messages subcollection, so nothing that lands here can be case
    // narrative. Every count is already k-anonymity-floored at write time
    // (MIN_AGGREGATE_CASES in analyticsThresholds.js): a category/department
    // breakdown below the floor is omitted from the document entirely, not
    // merely hidden by this rule, so this collection has no field a role
    // below the floor's protection would need shielded from it.
    //
    // Three readers, matching this module's requirement that Company Admin,
    // HR Coordinator and Case Handler all see the same aggregate stats - and
    // deliberately identical access for all three, unlike caseMetadata below:
    // there is no per-handler breakdown anywhere in this collection (no
    // byHandler field, unlike companies/{companyId}/stats/overview above), so
    // there is nothing here for a Case Handler read to expose about another
    // handler's assigned-case detail. Manager and Pulse Check Reviewer get no
    // path here - this is case-derived analytics, not the wellness-survey
    // surface those two roles already have their own aggregate views into.
    match /companies/{companyId}/analytics/{docId} {
      allow read: if isCompanyAdmin(companyId) || isHrCoordinator(companyId) || isCaseHandler(companyId);
      allow write: if false;
    }

    // Company-wide, metadata-only mirror of cases/{caseId} for the HR
    // Coordinator dashboard (module 13) - maintained by
    // functions/src/intake/syncCaseMetadata.js, which copies over only
    // category/severityScore/evidenceScore/status/assignedHandlerId/
    // department/priority/companyId/deadlines/timestamps. It deliberately
    // never includes `responses` (questionnaire free text) or anything from
    // the messages subcollection. It additionally carries the three pattern-detection fields
    // (subjectDepartment, subjectRoleTier, subjectSignatureHash) - the
    // department and coarse role tier of the person a report is about, derived
    // from the questionnaire by syncCaseMetadata.js so that
    // functions/src/patterns/ never needs a path to `responses`. A tier is a
    // bucket, a department is a team, and neither is a name; what keeps a
    // *signal* built from them non-identifying is the population check in
    // patterns/suppressionRules.js, not these fields being coarse.
    // It additionally carries the retaliation follow-up rollup
    // (followUpStatus) and the next-prompt time (nextFollowUpAt) from
    // functions/src/followup/*, so the HR Coordinator dashboard can show
    // follow-up counts and statuses as metadata only. Neither is identity-
    // bearing and the reporter's free-text answer is never mirrored (it never
    // lives on the case at all); a followUpStatus of 'no_response' means
    // UNKNOWN and is labelled as such, never as evidence no retaliation occurred.
    // It also carries tier/source/intakeMethod,
    // which are provenance rather than content - "filed by phone, reporter
    // chose to be identifiable" says nothing about what was reported - while
    // `reporterIdentity` and enteredByUid/enteredByRole are deliberately kept
    // off the mirror, so unlike cases/{caseId} this document CAN
    // be safely opened up for read: there's no free-text field on it a rule
    // would need to hide. This is what makes the "metadata only" constraint
    // a server-side guarantee rather than a client-side filter - the
    // HR Coordinator role never gets a rules path to the real case doc at
    // all, no matter what the dashboard code does.
    // Company Admin still has no read path here (or to cases/ or messages/
    // above) - the module 2 role design keeps Company Admin to settings and
    // structure only, never case content. Its one case-derived read is the
    // aggregate-only companies/{companyId}/stats/{statId} rollup above.
    //
    // Two roles get a deliberately narrower slice of the same mirror, split by
    // why routeCase.js could not place the case (see MANUAL_ASSIGNMENT_AUDIENCE
    // there). Both conditions are on resource.data, so a list query only
    // succeeds if it carries the matching equality filters itself - neither is
    // a path to the platform's or the company's whole case table, and both are
    // still metadata only.
    //
    // - Company Admin: their own company's cases stuck on 'no_routing_rule'
    //   or 'handler_not_designated' - the two reasons they can actually fix
    //   (RoutingRulesPage's "Needs attention" section; the JP-only
    //   designation gap is fixed on DesignatedHandlersPage instead). This is
    //   their second case-derived read after the aggregate stats rollup, and
    //   it stops at ids and routing metadata.
    // - Super Admin: 'conflict_of_interest' and 'missing_company_id' only.
    //   Conflict-of-interest cases are excluded from the Company Admin clause
    //   above on purpose - the company's own admins are exactly who the
    //   conflict check may have implicated, so they get no read path to those
    //   cases at all, not merely no button for them.
    match /caseMetadata/{caseId} {
      allow read: if isHrCoordinator(resource.data.companyId)
        || (isCompanyAdmin(resource.data.companyId)
          && resource.data.status == 'needs_manual_assignment'
          && (resource.data.routingReason == 'no_routing_rule'
            || resource.data.routingReason == 'handler_not_designated'))
        || (isSuperAdmin()
          && resource.data.status == 'needs_manual_assignment'
          && (resource.data.routingReason == 'conflict_of_interest'
            || resource.data.routingReason == 'missing_company_id'));
      allow write: if false;
    }

    // Module 16's cross-case pattern signals: a count of cases sharing a
    // department + role tier inside a rolling window, recomputed from scratch
    // daily by functions/src/patterns/detectPatterns.js and never written by a
    // client. A signal document holds counts, a tier, two dates and case ids -
    // no name, no questionnaire answer, no free text - and any group whose
    // matching employee population is too small to be anonymous never becomes
    // a document at all (functions/src/patterns/suppressionRules.js), so the
    // privacy guarantee here is that the row does not exist, not that a rule
    // hides it.
    //
    // Two readers, deliberately no others:
    // - HR Coordinator, company-wide. This is a third case-derived read for
    //   the role that already reads caseMetadata company-wide, and it is
    //   strictly coarser than that mirror.
    // - The Case Handler assigned to a case inside the signal, matched on
    //   handlerIds. This is the only reason handlerIds is on the document.
    //
    // Company Admin gets no path here even for their own company, and that is
    // not an oversight to be tidied up later: a pattern signal is derived from
    // case content, and the module 2 role design keeps Company Admin to
    // settings and structure, with its one case-derived read being the
    // aggregate stats rollup. Manager has no path either.
    //
    // The caseIds array is readable by a handler whose own case is in the
    // signal, and it stays inert: cases/{caseId} is still gated on
    // assignedHandlerId and caseMetadata/{caseId} on the hrCoordinator claim,
    // so holding an id from this array grants no read of the case behind it.
    match /patternSignals/{signalId} {
      allow read: if isHrCoordinator(resource.data.companyId)
        || (request.auth != null && request.auth.uid in resource.data.handlerIds);
      allow write: if false;
    }

    // The per-company run summary, doc id == companyId. Counts and thresholds
    // only - how many signals fired, how many groups were withheld as too
    // small to report safely, and the thresholds in force. It names no
    // department, tier or category on purpose: identifying WHICH group was
    // suppressed would be the same disclosure the suppression exists to
    // prevent. It exists so an HR Coordinator seeing an empty list can tell
    // "no pattern" apart from "a pattern that cannot be shown safely" instead
    // of being shown silence.
    match /patternSignalSummaries/{companyId} {
      allow read: if isHrCoordinator(companyId);
      allow write: if false;
    }

    // Department-level burnout report volume (functions/src/patterns/
    // detectBurnoutTrends.js) - a structurally different, weaker signal than
    // patternSignals above and deliberately its own collection so the two can
    // never be queried or displayed as if they carried the same weight.
    // Burnout has no accused party, so there is no per-person clustering
    // here and no caseIds/handlerIds field to match a Case Handler against -
    // that is why this collection has no handler-scoped read path at all,
    // unlike patternSignals. HR Coordinator only; Manager and Company Admin
    // get no path here, matching patternSignals' boundary and deliberately
    // not defaulting open to Manager even though Manager already sees Pulse
    // aggregate sentiment - department burnout volume is a more sensitive
    // signal than that and any widening is a decision for later, not a side
    // effect of adding this collection.
    match /burnoutTrendSignals/{signalId} {
      allow read: if isHrCoordinator(resource.data.companyId);
      allow write: if false;
    }

    // Per-company run summary for burnoutTrendSignals, doc id == companyId.
    // Same "counts and thresholds only, names no department" shape as
    // patternSignalSummaries above and for the same reason.
    match /burnoutTrendSummaries/{companyId} {
      allow read: if isHrCoordinator(companyId);
      allow write: if false;
    }

    // Routing/crisis/compliance/staff-invite notifications are metadata
    // queued for functions/src/notifications/sendCaseUpdate.js and staff
    // delivery - written only by Cloud Functions (routeCase.js,
    // checkOverdueDeadlines.js, inviteStaff.js) with the Admin SDK.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    // Module 10's cross-case consistency pool: scores + coarse metadata
    // only (see storeReferenceCase.js) about closed cases, from every
    // company. Written only by storeReferenceCase.js and read only by
    // checkConsistency.js, both with the Admin SDK - never exposed to any
    // client, since even metadata-only records about other companies'
    // closed cases have no business being client-readable.
    match /referenceCases/{referenceCaseId} {
      allow read, write: if false;
    }

    // Anonymous reporter push subscriptions (device token only). Doc ID is
    // the Case ID itself and the doc holds nothing but the push endpoint/keys
    // and template-rotation bookkeeping - no reporter identity, no case
    // content. Only Cloud Functions (registerPushSubscription, sendCaseUpdate
    // in functions/src/notifications/sendCaseUpdate.js) ever touch it; a
    // reporter has no Firebase Auth identity to write with directly, same as
    // every other case-scoped action in this app.
    match /pushSubscriptions/{caseId} {
      allow read, write: if false;
    }

    // Single-use pulse-check invites (module 14). A roster employee has no
    // Firebase Auth account, so the invite token in this doc is the only
    // credential that lets them reach and submit a pulse check - a named
    // credential, deliberately its OWN collection and not the anonymous case
    // passcode path (pushSubscriptions/cases), which are keyed and gated
    // entirely differently. Only the token's salted hash is stored here (same
    // scrypt scheme as a case passcode), never the plaintext. Every access -
    // validatePulseInvite to check one, submitPulseResponse to spend it - goes
    // through a Cloud Function with the Admin SDK, so no client rules path
    // exists: a client can neither read a hash to attack offline nor forge an
    // invite to submit as someone else.
    match /pulseInvites/{inviteId} {
      allow read, write: if false;
    }

    // Pulse Check (module 14) is structurally separate from the anonymous
    // case system: responses are tied to a named roster employee, identified
    // by their employees/{employeeId} roster doc id - not a Firebase Auth uid,
    // since roster employees have no account. Individual responses + their AI
    // analysis are readable only by HR Coordinator / Pulse Check Reviewer for
    // that company - never by Manager, and never written directly by a client
    // (submission goes through submitPulseResponse in functions/src/intake/
    // analyzePulseResponse.js, which reads companyId/department/employeeId off
    // the single-use invite server-side, so the employee identity can't be
    // spoofed).
    match /pulseResponses/{responseId} {
      allow read: if isHrCoordinator(resource.data.companyId) || isPulseReviewer(resource.data.companyId);
      allow write: if false;
    }
    // Pre-aggregated, department/period-level summaries with no individual
    // attribution - written only by the aggregation step inside
    // analyzePulseResponse.js. This is the ONLY pulse-check collection a
    // Manager or Company Admin can read; there is no rules path from either
    // role to pulseResponses above, so neither can ever reach an individual
    // record no matter how the client queries.
    match /pulseSummaries/{summaryId} {
      // HR Coordinator and Pulse Check Reviewer read every aggregate
      // unconditionally - they already have a rules path to the individual
      // pulseResponses above, so the minimum-response floor would protect
      // nothing from them. Manager and Company Admin read an aggregate only
      // once it is no longer suppressed: below MIN_AGGREGATE_RESPONSES (see
      // analyzePulseResponse.js) an "average" is really one person's score
      // attributed, which these two roles must never see. The suppressed==false
      // check here is what enforces the floor; the client query must carry a
      // matching where('suppressed','==',false) or Firestore rejects it whole.
      //
      // A Manager is additionally scoped to their own department(s): the
      // `departments` custom claim (set by inviteStaff.js / updateStaffDepartments.js)
      // is an array of department name strings, and a manager may only read an
      // aggregate whose department is in that array. This is deliberately a
      // token-only check - it reads request.auth.token exclusively and never
      // get()s a staff doc - so the departments list is a `where('department','in',...)`
      // the manager's own listPulseSummaries query must carry. `departments is list`
      // fails a manager with no (or a malformed) claim closed rather than erroring
      // the whole disjunction. Company Admin's access is unchanged: still every
      // non-suppressed aggregate for its company, no department predicate.
      // Suppression is no longer enforced by this read gate: the privacy
      // floor now lives in the projection itself (analyzePulseResponse.js
      // writes averageSentiment as null, never sentimentScoreSum, for any
      // below-floor department), so a Company Admin or Manager may read the
      // doc regardless of `suppressed` - they get responseCount and a null
      // average, never a reconstructable score. Requiring suppressed == false
      // here previously rejected the client's deliberately-unfiltered
      // listPulseSummaries query outright (Firestore denies a whole query
      // that could return a doc the rule would deny), which is what broke
      // Manager and Company Admin's pulse summary reads.
      // pulseAggregateView is this permission's composable-role equivalent of
      // Manager, and reads every non-suppressed aggregate for the company
      // the same way Company Admin does - company-wide, not department-
      // scoped like the legacy Manager claim above. The 'manager' fixed role
      // is left completely unchanged by this module (see the migration note
      // in functions/src/roles/customRoles.js): existing companies keep
      // Pulse Check aggregate access exactly as it worked before, and a
      // Company Admin who wants department-scoped access for a new hire
      // still invites them as a Manager, not a custom role - this permission
      // key is for a role that should see every department's aggregate, e.g.
      // an HR operations lead who isn't HR Coordinator.
      allow read: if isHrCoordinator(resource.data.companyId)
        || isPulseReviewer(resource.data.companyId)
        || isCompanyAdmin(resource.data.companyId)
        || (isManager(resource.data.companyId)
            && request.auth.token.departments is list
            && resource.data.department in request.auth.token.departments)
        || hasCustomPermission(resource.data.companyId, 'pulseAggregateView');
      allow write: if false;
    }
    // The raw accumulator behind each pulseSummaries projection - responseCount
    // and sentimentScoreSum only, written under the same doc id in the same
    // transaction by analyzePulseResponse.js. sentimentScoreSum is exactly the
    // field that, divided by responseCount, would reconstruct one person's
    // score for a below-floor department, so it lives here where NO client role
    // has a rules path at all - the same fully-sealed posture as
    // identityAccessAuditLog below. The Manager-readable pulseSummaries doc
    // never contains it.
    match /pulseSummaryTotals/{summaryId} {
      allow read, write: if false;
    }

    // Audit trail for functions/src/utils/identityVault.js's decryptIdentity
    // calls - every attempt to decrypt a confidential-tier reporter identity
    // or burner email, granted or denied, lands here with who/when/case/
    // reason. Written only by identityVault.js with the Admin SDK; no client
    // role, including Super Admin, gets a rules path to read or write it
    // directly, since a mutable audit trail isn't an audit trail.
    //
    // Since module 20 it also records the events that CHANGE what the vault
    // holds without decrypting anything: a reporter identifying themselves
    // mid-case ('reporter_self_reveal'), and a contact address being added or
    // removed. Every entry carries an `action`, so a staff decrypt
    // ('staff_reveal') and a reporter's own disclosure never read alike. They
    // share this one collection rather than getting a second so that "what has
    // ever happened to this case's identity data" is one query.
    match /identityAccessAuditLog/{entryId} {
      allow read, write: if false;
    }

    // The same audit discipline for the other read of case content that is
    // not the assigned handler's: every getCaseForTriage call
    // (functions/src/investigation/getCaseForTriage.js), granted or denied,
    // records who opened which unassigned case and when. Written only by
    // that callable with the Admin SDK. No role gets a rules path here -
    // an HR Coordinator or Company Admin being able to edit the record of
    // what they read would defeat the point of keeping one.
    match /triageAccessLog/{entryId} {
      allow read, write: if false;
    }

    // The third audited surface, and the same discipline again: every case a
    // staff member files on behalf of a reporter
    // (functions/src/intake/createCaseOnBehalf.js) records who filed it, for
    // which company, by what intake method, at what tier, whether an identity
    // was vaulted and which *field names* it holds, and how far the report was
    // backdated. Never an identity value, never a questionnaire answer - the
    // log describes the act of filing, not the report, so an auditor can read
    // it end to end without it becoming a second copy of the case.
    //
    // Written only by that callable with the Admin SDK. No client role gets a
    // path here, including the staff member who filed and the Super Admin: the
    // record of who typed up whose report is exactly the record that must not
    // be editable by the person who typed it.
    match /staffIntakeAuditLog/{entryId} {
      allow read, write: if false;
    }

    // The fourth audited surface. Evidence files are no longer reachable by a
    // direct Storage URL (storage.rules denies all client access to
    // case-evidence/**); every upload and every download now goes through a
    // short-lived signed URL minted by
    // functions/src/intake/evidenceAccess.js, and every one of those, granted
    // or denied, is recorded here: who (a staff uid, or the literal 'reporter'
    // - a reporter has no identity to record and recording one would undo the
    // anonymity the rest of this file protects), which case, which file, when.
    //
    // Same discipline as the three logs above: Admin SDK writes only, no
    // client path for any role. Whoever read a piece of evidence must not be
    // able to edit the record that they read it.
    match /evidenceAccessLog/{entryId} {
      allow read, write: if false;
    }

    // Module 23's deletion record: one entry per case purged/deleted, per
    // legal hold placed/released, and per erasure request decided (see
    // functions/src/retention/applyRetention.js, legalHold.js,
    // deletionRequest.js - the only writers, all Admin SDK). Deliberately
    // readable, unlike the four audit logs above: this log's entire purpose
    // is to let a Company Admin (or Super Admin) show that deletion happened
    // on request - a DPA answer nobody can give from a log they cannot read.
    // It stays write-sealed regardless, and it is scoped to hold no case
    // content, no category, no scores and no identity by construction (see
    // the writers) - so opening read access here is not the same class of
    // exposure as opening any of the logs above would be.
    match /deletionLog/{entryId} {
      allow read: if isCompanyAdmin(resource.data.companyId) || isSuperAdmin();
      allow write: if false;
    }

    // Module 24's export record: one entry per PDF a case's report was
    // rendered into (functions/src/reports/exportReportPdf.js, the only
    // writer, Admin SDK only). Fields are metadata about the export event -
    // who, when, the Storage path, the two content hashes, whether identity
    // was included, page/byte counts - never the case content itself, so
    // opening read access here is the same class of exposure as
    // deletionLog above, not the class evidenceAccessLog and the identity
    // logs are sealed against.
    //
    // Two readers: the case's own assigned handler (get() into the case doc,
    // same assignedHandlerId check cases/{caseId} enforces directly), so an
    // investigator can see that this case's report left the system three
    // times last month; and Company Admin, company-wide, so a DPA-style
    // question ("how many times has this case's report been exported, and by
    // whom") has an answer without a Super Admin needing to be looped in.
    // Super Admin is not given a blanket read here on purpose - a report
    // export is scoped to the one company and the one assigned handler who
    // can also generate it, and Super Admin has no exportReportPdf access
    // path of its own to match (see the callable's own comment on why it has
    // no Super Admin branch).
    match /reportExports/{exportId} {
      allow read: if isCompanyAdmin(resource.data.companyId)
        || (request.auth != null
          && get(/databases/$(database)/documents/cases/$(resource.data.caseId)).data.assignedHandlerId == request.auth.uid);
      allow write: if false;
    }

    // Module 25's cross-company benchmark pool. Three collections, and the
    // access model is deliberately not "readable by any staff of any company":
    // reading a cell requires the caller's company to be currently opted in
    // to CONTRIBUTING to the pool. A pool that can be read without
    // contributing collapses into a one-way intelligence product, and every
    // company opts out of contributing. That gate is not a rules predicate
    // because it needs to load two Firestore docs (the caller's staff role
    // and the opt-in state) and then hand back four exact cells - it lives
    // in functions/src/benchmark/benchmarkAccess.js. So client rules stay
    // fully sealed here, and every read goes through the callable.
    //
    // Cells hold aggregate statistics only, never a company's identity: a
    // cell that clears MIN_COMPANIES_PER_CELL and MIN_CASES_PER_CELL
    // publishes rounded medians, quartiles, and a rounded action
    // distribution; below either threshold the document is written with
    // suppressed:true and NO statistics - not computed and withheld at read
    // time, not computed at all. Even so, the direct client path is closed:
    // "you may only read a cell your company also fed" is a rule the
    // callable enforces and this collection has no equivalent way to say.
    match /benchmarkCells/{cellId} {
      allow read, write: if false;
    }

    // The opt-in state and its append-only history. Written only by
    // setBenchmarkOptIn (Admin SDK) so the actor uid and server timestamp on
    // every change are trustworthy - a client-writable opt-in doc could be
    // backdated or attributed to another admin, and neither is acceptable on
    // a control the company is expected to withdraw. History entries are
    // sealed for the same reason the identity audit log is sealed: a
    // mutable record of who opted in and when is not a record.
    match /benchmarkOptIns/{companyId} {
      allow read, write: if false;
      match /history/{historyId} {
        allow read, write: if false;
      }
    }

    // Per-run summary, doc id == YYYY-MM. Counts only - opted-in company
    // count, published cell count, suppressed cell count, thresholds - never
    // a company id and never a cell coordinate. This is the one document
    // Super Admin has a legitimate operational reason to read ("did the
    // pool compute this month, how many cells cleared"), but the rules
    // stay closed and any Super Admin read goes through a callable so that
    // the "aggregate statistics only, never raw case data" constraint is
    // enforced by there being no client path at all.
    match /benchmarkRuns/{runId} {
      allow read, write: if false;
    }

    // Rate-limit counters (functions/src/utils/rateLimit.js). Written only by
    // the Admin SDK inside the limiter's transaction; a client that could
    // read these could measure how close it is to a limit, and one that could
    // write them could reset its own counter, so neither is allowed.
    //
    // Documents here hold a salted, coarsened, daily-rotating fingerprint - no
    // IP, no reporter identity - and carry expiresAt for a Firestore TTL
    // policy. Set that policy on rateLimits.expiresAt at deploy time: without
    // it the collection grows without bound and the "short-lived" half of the
    // fingerprint's privacy argument stops being true.
    match /rateLimits/{counterId} {
      allow read, write: if false;
    }

    // Module 26: Security Control & Evidence Layer. Every collection below is
    // written only by the Admin SDK - a scheduled control
    // (functions/src/security/*.js) or one of its onCall counterparts - so
    // every match block here denies client writes outright, the same
    // "Admin-SDK-write-only, append-only" posture identityAccessAuditLog and
    // the other three pre-existing audit logs already hold. Where a Super
    // Admin needs to browse the evidence directly, read is opened to that one
    // role; two collections are pure server-internal working state (a
    // resumable scan cursor, a rolling anomaly baseline) with no operator
    // value in a UI at all and stay fully sealed, the same way rateLimits
    // above does.

    // Findings + control-run collections a Super Admin reads directly on
    // SecurityDashboard.jsx - securityAlerts, keyRotationLog and
    // keyRotationState, integrityFindings, backupVerifications and
    // securityControlRuns. None of these can ever contain case content: every
    // writer in functions/src/security/ is built from other metadata-only
    // collections (privilegedActionLog, the four pre-existing audit logs,
    // caseMetadata, staff docs, Storage object listings) and never reads
    // cases/{caseId} or a messages subcollection.
    match /securityAlerts/{alertId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /keyRotationLog/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /keyRotationState/{keyId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /integrityFindings/{findingId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /backupVerifications/{period} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /securityControlRuns/{runId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // The quarterly CC6.2/CC6.3 artifact (functions/src/security/
    // accessReview.js). Deliberately NOT opened to a Company Admin here, even
    // for their own company's row - a Company Admin who needs to see what
    // they are attesting reads it through getAccessReviewForAttestation
    // (Admin SDK, re-checks the staff role server-side), not a Firestore
    // rule, so this stays at the same "Super Admin read, Admin-SDK write
    // only" posture as securityAlerts and keyRotationLog above. Attestation
    // itself only ever happens through attestAccessReview, never a direct
    // write - a review a Company Admin could edit in place after signing it
    // would not be an attestation.
    match /accessReviews/{reviewId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Module 26's chokepoint-level privileged-action trail (functions/src/
    // utils/staffAuth.js's logPrivilegedAction) - who attempted which action
    // type, granted or denied, when. Same fully-sealed posture as
    // identityAccessAuditLog, triageAccessLog, staffIntakeAuditLog and
    // evidenceAccessLog above: no client role, INCLUDING Super Admin, gets a
    // read path, because a mutable audit trail is not an audit trail and this
    // is the one log every other log in this app already treats that way.
    // accessReview.js and anomalyDetection.js read it with the Admin SDK to
    // build their own Super-Admin-readable artifacts (accessReviews,
    // securityAlerts) - that derived read is how this log's contents reach a
    // screen, never a direct query.
    match /privilegedActionLog/{entryId} {
      allow read, write: if false;
    }

    // Pure server-internal working state with no operator-facing meaning of
    // its own: a resumable scan position for integrityCheck.js's rotating
    // weekly sweep, and the rolling per-key exponential-moving-average
    // anomalyDetection.js compares each day's count against. Neither is
    // evidence an auditor would ask to see - the FINDINGS these states help
    // produce (integrityFindings, securityAlerts) are the evidence - so
    // unlike the collections above, opening Super Admin read here would only
    // add a screen nobody needs to look at.
    match /integrityCheckCursors/{checkId} {
      allow read, write: if false;
    }
    match /anomalyBaselines/{key} {
      allow read, write: if false;
    }

    // CI vulnerability-scan results (npm audit, recorded by the CI pipeline -
    // see the repo's GitHub Actions workflow and functions/scripts/
    // recordDependencyScan.js). Change management and vulnerability
    // management are both tested by an auditor asking "show me your scan
    // history", so this is readable evidence like securityAlerts above, not
    // sealed like privilegedActionLog.
    match /dependencyScans/{scanId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Module 27: External Advisor Share Links. Both collections are reached
    // only through Cloud Functions (functions/src/sharing/*.js), including
    // for a Super Admin - unlike deletionLog/reportExports/dependencyScans
    // above, there is no dashboard reason to open these to a direct client
    // read.
    //
    // externalShares holds a scrypt hash and salt of the bearer token that
    // is the ENTIRE access control for a shared case view - a mutable-by-
    // client or readable-by-client document here would mean any staff
    // account (or, if the read were ever widened, an external recipient's
    // own client) could learn or forge what should be an unguessable
    // 32-byte secret. It also holds an encrypted recipientEmail envelope,
    // held to the same standard as reporterIdentity: the vault decides who
    // may ever decrypt it, not a rules predicate on this collection - and in
    // this module's case, nothing ever decrypts it again after creation, so
    // there is no read path to design for at all.
    //
    // Company Admin has no path to either collection, matching this
    // module's own constraint that Company Admin cannot create, view, or
    // extend a share - there is nothing for a rule to narrow here, because
    // the narrowing is "no path exists."
    match /externalShares/{shareId} {
      allow read, write: if false;
    }

    // Every attempt to open a shared-case link, granted or denied - same
    // audit discipline as evidenceAccessLog and the other sealed logs:
    // whoever opened this link must not be able to edit the record that
    // they opened it, and neither can anyone else, including Super Admin.
    match /externalAccessLog/{entryId} {
      allow read, write: if false;
    }

    // Module 49: External Advisor Feedback (Review Queue). Sealed exactly
    // like externalShares above - every access goes through the three
    // callables in functions/src/sharing/{submitExternalComment,
    // reviewExternalComment,listExternalComments}.js, including for a Super
    // Admin. This collection carries real case-adjacent content (the
    // recipient's actual feedback text), unlike reportExports' metadata-only
    // shape, so it follows cases/{caseId}'s own access model - assigned Case
    // Handler only, no Company Admin path - not reportExports' broader one.
    match /externalShareComments/{commentId} {
      allow read, write: if false;
    }
  }
}
