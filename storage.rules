rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Case evidence is closed to every client, unconditionally.
    //
    // This used to be `allow read, write: if true`, on the reasoning that a
    // reporter has no Firebase Auth identity to gate against. The consequence
    // was that every uploaded evidence file was readable by anyone who could
    // guess a Case ID and writable by anyone at all, and that the download
    // URLs handed out were permanent.
    //
    // Access now runs entirely through the Admin SDK:
    // functions/src/intake/evidenceAccess.js validates the caller the same way
    // the rest of the case does - Case ID + passcode for a reporter,
    // Firebase Auth + case assignment for a handler - and returns a signed URL
    // valid for at most 15 minutes. Every issued URL is written to
    // evidenceAccessLog. The absence of an auth identity was never a reason to
    // leave the bucket open; it is a reason for the check to happen on a
    // server that can perform it.
    //
    // Signed URLs are generated with the service account's own credentials and
    // bypass these rules, so denying everything here does not affect them.
    // Files uploaded under the old open rule are no longer reachable by their
    // old URLs. That is intended and there is no compatibility path for them.
    match /case-evidence/{caseId}/{fileName} {
      allow read, write: if false;
    }

    // Company policy documents (module 19) are closed to every client for the
    // same reason and in the same way as case evidence above. A Company Admin
    // uploads through a short-lived V4 signed URL minted by
    // functions/src/policy/policyAccess.js after the caller is verified as a
    // Company Admin of the owning company; the investigation roles download
    // through the same callable path. Signed URLs use the service account's own
    // credentials and bypass these rules, so denying everything here does not
    // affect them. All access is signed-URL only, same as case-evidence.
    match /company-policies/{companyId}/{policyId}/{fileName} {
      allow read, write: if false;
    }

    // Module 24's exported closed-case PDFs. Same lockdown, same reason as
    // case-evidence above, and higher stakes: a case report is the single
    // most sensitive document this system produces, not one attachment out
    // of several. functions/src/reports/exportReportPdf.js writes the file
    // here with the Admin SDK after the caller passes the exact same
    // authorization generateReport.js requires (the assigned handler, no new
    // access path), and hands back a 15-minute v4 signed URL - never a
    // permanent one, and never persisted anywhere the client can read it
    // back out. Signed URLs use the service account's own credentials and
    // bypass these rules, so denying everything here does not affect them.
    match /case-reports/{caseId}/{fileName} {
      allow read, write: if false;
    }

    // Nothing else in this bucket is client-accessible either. Stated
    // explicitly rather than left to the implicit default, so a future path
    // added under a new prefix is denied by this rule rather than by nobody
    // having remembered to write one.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
