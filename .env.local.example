# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real Firebase credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to connect to local Firebase emulators in development.
VITE_USE_FIREBASE_EMULATORS=false

# AES secret for src/utils/encryption.js - only protects identity/sensitive
# data transiently held in the browser (e.g. an intake draft cached to
# sessionStorage). Not the encryption-at-rest key; that's the Cloud
# Functions secret IDENTITY_VAULT_ENCRYPTION_KEY (see
# functions/src/utils/identityVault.js), set via `firebase functions:secrets:set`,
# never in this file.
VITE_ANONYMOUS_SECRET=

# VAPID public key for Web Push (Module 22). Generate the pair with
# `npx web-push generate-vapid-keys`, then:
#   - put the PUBLIC half here (it's shipped to the client anyway),
#   - set the PRIVATE half as the VAPID_PRIVATE_KEY Cloud Functions
#     secret via `firebase functions:secrets:set VAPID_PRIVATE_KEY`,
#   - and set the SAME public value as the VAPID_PUBLIC_KEY Cloud
#     Functions secret too (sendCaseUpdate.js reads both halves
#     server-side to sign the push).
# Never put the private half in this file.
VITE_VAPID_PUBLIC_KEY=

# Stripe billing (see functions/src/billing/). Deliberately no VITE_ variable
# here: the app never loads Stripe.js and never needs a publishable key -
# createBillingCheckoutSession/createBillingPortalSession both return a
# Stripe-hosted URL the browser redirects straight to. The two Stripe values
# this app does need are both server-side Cloud Functions secrets, set with
# `firebase functions:secrets:set`, never in this file:
#   STRIPE_SECRET_KEY     - the API key (functions/src/billing/stripeClient.js)
#   STRIPE_WEBHOOK_SECRET - verifies the Stripe-Signature header on
#                           stripeWebhook.js; get this from the webhook
#                           endpoint's settings in the Stripe Dashboard once
#                           that function's deployed URL is registered there.
